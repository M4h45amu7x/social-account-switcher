{
  "name": "social-account-switcher",
  "version": "0.2.0",
  "private": true,
  "description": "Chrome extension (MV3) to switch between your own Facebook, Instagram, YouTube and TikTok accounts \u2014 all data stays on your device.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json",
    "lint": "biome ci . && bun scripts/check-chrome-access.ts",
    "fix": "biome check --write .",
    "test": "bun test tests/unit",
    "e2e": "playwright test",
    "perm:check": "bun scripts/check-permissions.ts",
    "zip": "bun run build && bun scripts/zip.ts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run perm:check",
    "icons": "bun scripts/icons.ts",
    "screenshots": "bun scripts/screenshots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@happy-dom/global-registrator": "21.0.4",
    "@playwright/test": "1.65.0",
    "@types/bun": "1.4.4",
    "@types/chrome": "0.3.7",
    "fflate": "0.8.3",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
